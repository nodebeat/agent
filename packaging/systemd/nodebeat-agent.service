[Unit]
Description=NodeBeat monitoring agent (non-custodial, read-only)
Documentation=https://github.com/nodebeat/agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nodebeat
Group=nodebeat
# Written by install.sh; holds no secret. The ingest token is only in
# /var/lib/nodebeat/ingest-token (0600), read by the agent and Alloy.
# NB_VALIDATORS is read from this environment directly. Every NB_* is always
# written, so no flag ever expands empty in a way the agent cannot parse.
# Re-run install.sh after editing agent.env by hand.
EnvironmentFile=/etc/nodebeat/agent.env
# Children are resolved only from here: the Alloy (and Cosmos watcher)
# binaries install.sh version-checked and copied.
Environment=PATH=/usr/local/lib/nodebeat/bin
ExecStart=/usr/local/bin/nodebeat-agent run \
  --enrolled=${NB_ENROLLED} \
  --target ${NB_TARGET} \
  --remote-write-url ${NB_REMOTE_WRITE_URL} \
  --instance ${NB_INSTANCE} \
  --chain ${NB_CHAIN} \
  --el-rpc-port ${NB_EL_RPC_PORT} \
  --beacon-port ${NB_BEACON_PORT} \
  --el-metrics-port ${NB_EL_METRICS_PORT} \
  --cl-metrics-port ${NB_CL_METRICS_PORT} \
  --el-p2p-port ${NB_EL_P2P_PORT} \
  --cl-p2p-port ${NB_CL_P2P_PORT} \
  --cosmos-rpc-port ${NB_COSMOS_RPC_PORT} \
  --cosmos-rest-port ${NB_COSMOS_REST_PORT} \
  --cosmos-metrics-port ${NB_COSMOS_METRICS_PORT} \
  --cosmos-p2p-port ${NB_COSMOS_P2P_PORT} \
  --state-dir /var/lib/nodebeat
WorkingDirectory=/var/lib/nodebeat
StateDirectory=nodebeat
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5s

# Hardening. Writes: only the state dir. Exec: only the agent, the binaries
# in /usr/local/lib/nodebeat/bin, and shared libraries (dynamically linked
# children need the loader and libc). Inbound listeners: agent diagnostics
# (incl. the Ethereum poller's /chain/metrics and /chain/duties), Alloy UI
# and cosmos-validator-watcher all bind localhost; nothing listens on an
# external interface. ProtectClock is deliberately off: it also blocks the
# read-only adjtimex call behind node_timex_offset_seconds (ClockSkew rule).
NoExecPaths=/
ExecPaths=/usr/local/bin/nodebeat-agent /usr/local/lib/nodebeat/bin /usr/lib /lib /usr/lib64 /lib64
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

[Install]
WantedBy=multi-user.target
