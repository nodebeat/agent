[Unit]
Description=NodeBeat monitoring agent (non-custodial, read-only)
Documentation=https://github.com/nodebeat/agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nodebeat
Group=nodebeat
EnvironmentFile=/etc/nodebeat/agent.env
# The ingest token is NOT passed as a flag (argv is world-readable via ps):
# the agent reads NB_INGEST_TOKEN from this EnvironmentFile directly.
# Port overrides (devnet ephemeral host ports). install.sh always writes every
# NB_*_PORT (defaults = standards, metrics 0 = per-client default), so no
# flag ever expands empty. Re-run install.sh after editing agent.env.
ExecStart=/usr/local/bin/nodebeat-agent run \
  --target ${NB_TARGET} \
  --remote-write-url ${NB_REMOTE_WRITE_URL} \
  --instance ${NB_INSTANCE} \
  --chain ${NB_CHAIN} \
  --el-rpc-port ${NB_EL_RPC_PORT} \
  --beacon-port ${NB_BEACON_PORT} \
  --el-metrics-port ${NB_EL_METRICS_PORT} \
  --cl-metrics-port ${NB_CL_METRICS_PORT} \
  --el-p2p-port ${NB_EL_P2P_PORT} \
  --cl-p2p-port ${NB_CL_P2P_PORT} \
  --cosmos-rpc-port ${NB_COSMOS_RPC_PORT} \
  --cosmos-rest-port ${NB_COSMOS_REST_PORT} \
  --cosmos-metrics-port ${NB_COSMOS_METRICS_PORT} \
  --cosmos-p2p-port ${NB_COSMOS_P2P_PORT} \
  --state-dir /var/lib/nodebeat
WorkingDirectory=/var/lib/nodebeat
StateDirectory=nodebeat
Restart=on-failure
RestartSec=5s

# Hardening: read-only host view, writes confined to the state dir, no new
# privileges, no exec of anything outside the supervised child binaries.
# Inbound listeners: agent diagnostics (incl. the Ethereum poller's
# /chain/metrics), Alloy UI and cosmos-validator-watcher all bind localhost;
# nothing listens on an external interface.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0027
ReadWritePaths=/var/lib/nodebeat

[Install]
WantedBy=multi-user.target
