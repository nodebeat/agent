# NodeBeat agent configuration. Written as /etc/nodebeat/agent.env
# (root:nodebeat, 0640) by packaging/install.sh and read by the systemd unit.
# Holds no secret: the ingest token is only in /var/lib/nodebeat/ingest-token.
# Every variable must be present (the unit passes each as a flag).
#
# true = SaaS: sink and instance name come from /var/lib/nodebeat/enrollment.json
# (install.sh --control-plane); leave NB_REMOTE_WRITE_URL and NB_INSTANCE empty.
NB_ENROLLED=false
NB_TARGET=127.0.0.1
NB_REMOTE_WRITE_URL=https://ingest.example:8428/api/v1/write
NB_INSTANCE=
# Restrict detection to one chain family on mixed hosts (empty = auto).
NB_CHAIN=
# Validators whose duties to alert on (empty = none).
NB_VALIDATORS=
# Target ports (devnet ephemeral host ports). Metrics 0 = per detected
# client default.
NB_EL_RPC_PORT=8545
NB_BEACON_PORT=5052
NB_EL_METRICS_PORT=0
NB_CL_METRICS_PORT=0
NB_EL_P2P_PORT=30303
NB_CL_P2P_PORT=9000
NB_COSMOS_RPC_PORT=26657
NB_COSMOS_REST_PORT=1317
NB_COSMOS_METRICS_PORT=0
NB_COSMOS_P2P_PORT=26656
