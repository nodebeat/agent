# NodeBeat agent configuration. Installed as /etc/nodebeat/agent.env
# (root:nodebeat, 0640) by packaging/install.sh. Values are referenced by
# the systemd unit.
NB_TARGET=127.0.0.1
NB_REMOTE_WRITE_URL=https://ingest.example:8428/api/v1/write
NB_INSTANCE=
# Bearer token for remote-write through the auth-enforcing ingest proxy.
# Empty = no auth block (lab backends without auth). Prefer setting it via
# NODEBEAT_INGEST_TOKEN env at install time over --ingest-token.
NB_INGEST_TOKEN=
# Target port overrides (devnet ephemeral host ports). Unset in practice is
# not supported by the unit — install.sh always writes every var below.
# Metrics 0 = per detected client default.
NB_EL_RPC_PORT=8545
NB_BEACON_PORT=5052
NB_EL_METRICS_PORT=0
NB_CL_METRICS_PORT=0
NB_EL_P2P_PORT=30303
NB_CL_P2P_PORT=9000
NB_COSMOS_RPC_PORT=26657
NB_COSMOS_REST_PORT=1317
NB_COSMOS_METRICS_PORT=0
NB_COSMOS_P2P_PORT=26656
