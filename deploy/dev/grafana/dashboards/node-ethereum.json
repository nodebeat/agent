{
  "uid": "nodebeat-node-ethereum",
  "title": "NodeBeat Node: Ethereum",
  "tags": [
    "nodebeat",
    "node",
    "ethereum"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "link",
      "title": "Fleet",
      "icon": "dashboard",
      "url": "/d/nodebeat-fleet/nodebeat-fleet",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "asDropdown": false,
      "tags": [],
      "tooltip": "Back to the fleet view"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Ethereum node",
        "description": "Ethereum nodes in this organization. Cosmos nodes have their own dashboard: open them from Fleet.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "label_values(up{chain=\"ethereum\"}, instance)",
        "query": {
          "query": "label_values(up{chain=\"ethereum\"}, instance)",
          "refId": "instance"
        },
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1,
        "current": {}
      },
      {
        "name": "method",
        "label": "RPC method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "definition": "query_result(sort_desc(sum by (method) (nodebeat:rpc_calls:rate2m{instance=\"$instance\"}) > 0))",
        "query": {
          "query": "query_result(sort_desc(sum by (method) (nodebeat:rpc_calls:rate2m{instance=\"$instance\"}) > 0))",
          "refId": "method"
        },
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 0,
        "current": {},
        "regex": "/method=\"([^\"]+)\"/",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Consensus",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance) (2 * group by (instance) (ALERTS{alertstate=\"firing\",component=\"consensus\",severity=\"critical\",instance=\"$instance\"}) or 1 * group by (instance) (ALERTS{alertstate=\"firing\",component=\"consensus\",severity=\"warning\",instance=\"$instance\"}) or 0 * group by (instance) (last_over_time(up{instance=\"$instance\"}[7d])))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "WARN",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "CRIT",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
