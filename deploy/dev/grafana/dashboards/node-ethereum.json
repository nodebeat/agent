    {
      "id": 42,
      "type": "timeseries",
      "title": "RPC calls by method",
      "description": "JSON-RPC calls per second by method (2m rate), from the execution client's own metrics. Includes the agent's own 1/s health polls (eth_syncing, eth_getBlockByNumber, net_peerCount, eth_gasPrice). Geth needs --metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (method) (nodebeat:rpc_calls:rate2m{instance=\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "RPC error ratio by method",
      "description": "Share of calls that returned a JSON-RPC error. eth_call/eth_estimateGas errors are usually reverts (the caller's fault) and never alert. For node-fault methods, RPCMethodErrorRateHigh pages at 14.4x burn of a 99.9% objective (>1.44% over 1h and 5m) and RPCMethodErrorRateElevated warns at 6x (>0.6% over 6h and 30m).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 47,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (method) (nodebeat:rpc_calls:rate2m{instance=\"$instance\",outcome=\"failure\"}) / sum by (method) (nodebeat:rpc_calls:rate2m{instance=\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 44,
      "type": "timeseries",
      "title": "RPC p99 latency by method",
      "description": "p99 per scrape interval, successful and failed calls separately; gaps mean no calls. A slow failure is a timeout (Geth aborts eth_call at 5s). RPCMethodLatencyHigh warns when a standard read stays above 2s for 5m with at least 100 calls in 5m.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 47,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
